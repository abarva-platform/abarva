        <text x="1012" y="97" text-anchor="middle" font-size="13" font-weight="700">5</text>
        <text x="1012" y="140" text-anchor="middle" font-size="12" font-weight="700"><tspan x="1012" dy="0">Retrieval service</tspan></text>
        <text x="1012" y="174" text-anchor="middle" font-size="10" fill="#6b6b66"><tspan x="1012" dy="0">Data &amp; ML Platform</tspan></text>
      </g><path d="M1280 92 L1404 92" stroke="var(--data)" stroke-width="2" marker-end="url(#arrow)"/><g>
