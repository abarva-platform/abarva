    <div class="band-nodes"><div class="node k-system">
    <div class="node-h"><span class="node-label">FIS IST/Profile</span><span class="badge st st-existing">Existing</span></div>
    <div class="svc">Mainframe core</div>
  </div><div class="node k-control">
    <div class="node-h"><span class="node-label">Actimize / Feedzai / MRM</span><span class="badge st st-existing">Existing</span></div>
    <div class="svc">AML + model-risk controls</div>
  </div></div>
  </div><div class="band">
