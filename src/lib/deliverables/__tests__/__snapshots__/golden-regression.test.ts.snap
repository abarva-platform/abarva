        <text x="132" y="97" text-anchor="middle" font-size="13" font-weight="700">1</text>
        <text x="132" y="140" text-anchor="middle" font-size="12" font-weight="700"><tspan x="132" dy="0">Email / courier intake →</tspan><tspan x="132" dy="14">Manual...</tspan></text>
        <text x="132" y="174" text-anchor="middle" font-size="10" fill="#6b6b66"><tspan x="132" dy="0">documents</tspan></text>
      </g><path d="M400 92 L524 92" stroke="var(--data)" stroke-width="2" marker-end="url(#arrow)"/><g>
        <circle cx="352" cy="92" r="28" fill="#fff" stroke="var(--data)" stroke-width="2"/>
        <text x="352" y="97" text-anchor="middle" font-size="13" font-weight="700">2</text>
        <text x="352" y="140" text-anchor="middle" font-size="12" font-weight="700"><tspan x="352" dy="0">Manual document review →</tspan><tspan x="352" dy="14">Trade...</tspan></text>
        <text x="352" y="174" text-anchor="middle" font-size="10" fill="#6b6b66"><tspan x="352" dy="0">keyed data</tspan></text>
      </g><path d="M620 92 L744 92" stroke="var(--data)" stroke-width="2" marker-end="url(#arrow)"/><g>
        <circle cx="572" cy="92" r="28" fill="#fff" stroke="var(--data)" stroke-width="2"/>
        <text x="572" y="97" text-anchor="middle" font-size="13" font-weight="700">3</text>
        <text x="572" y="140" text-anchor="middle" font-size="12" font-weight="700"><tspan x="572" dy="0">Manual document review →</tspan><tspan x="572" dy="14">Manual...</tspan></text>
        <text x="572" y="174" text-anchor="middle" font-size="10" fill="#6b6b66"><tspan x="572" dy="0">exceptions</tspan></text>
      </g><path d="M840 92 L964 92" stroke="var(--data)" stroke-width="2" marker-end="url(#arrow)"/><g>
        <circle cx="792" cy="92" r="28" fill="#fff" stroke="var(--data)" stroke-width="2"/>
        <text x="792" y="97" text-anchor="middle" font-size="13" font-weight="700">4</text>
        <text x="792" y="140" text-anchor="middle" font-size="12" font-weight="700"><tspan x="792" dy="0">Trade Finance system →</tspan><tspan x="792" dy="14">FIS...</tspan></text>
        <text x="792" y="174" text-anchor="middle" font-size="10" fill="#6b6b66"><tspan x="792" dy="0">postings</tspan></text>
      </g><g>
        <circle cx="1012" cy="92" r="28" fill="#fff" stroke="var(--data)" stroke-width="2"/>
        <text x="1012" y="97" text-anchor="middle" font-size="13" font-weight="700">5</text>
        <text x="1012" y="140" text-anchor="middle" font-size="12" font-weight="700"><tspan x="1012" dy="0">Trade Finance system →</tspan><tspan x="1012" dy="14">NICE...</tspan></text>
        <text x="1012" y="174" text-anchor="middle" font-size="10" fill="#6b6b66"><tspan x="1012" dy="0">screening</tspan></text>
      </g>
  </svg><div class="statemap"><div class="band">
    <div class="band-label">Experience &amp; Channels</div>
    <div class="band-nodes"><div class="node k-channel">
    <div class="node-h"><span class="node-label">Email / courier intake</span><span class="badge st st-existing">Existing</span></div>
    <div class="note">Unstructured L/C documents arrive ad hoc.</div>
  </div><div class="node k-application">
    <div class="node-h"><span class="node-label">Trade Finance ops portal</span><span class="badge st st-existing">Existing</span></div>
    
  </div></div>
  </div><div class="band">
    <div class="band-label">Applications &amp; Services</div>
    <div class="band-nodes"><div class="node k-application">
    <div class="node-h"><span class="node-label">Manual document review</span><span class="badge st st-existing">Existing</span></div>
    <div class="note">Officer reads, compares clauses, keys data.</div>
  </div><div class="node k-application">
    <div class="node-h"><span class="node-label">Manual exception tracking</span><span class="badge st st-existing">Existing</span></div>
    <div class="note">Spreadsheets / email threads.</div>
  </div></div>
  </div><div class="band">
    <div class="band-label">Data &amp; ML Platform</div>
