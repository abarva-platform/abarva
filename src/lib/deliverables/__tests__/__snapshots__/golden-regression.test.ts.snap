        <text x="572" y="174" text-anchor="middle" font-size="10" fill="#6b6b66"><tspan x="572" dy="0">EventBridge</tspan></text>
      </g><path d="M840 92 L964 92" stroke="var(--data)" stroke-width="2" marker-end="url(#arrow)"/><g>
