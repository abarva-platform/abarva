{
  "schema_id": "airline-demo-new-dataset-manifest-schema/v1",
  "tenant_key": "airline-demo-new",
  "release": "airline-demo-new-source-corpus-v1.0.0",
  "required_fields": [
    "source_id",
    "tenant_key",
    "source_release",
    "source_name",
    "source_type",
    "sensitivity",
    "owner_role",
    "format",
    "storage_container",
    "tenant_rooted_path",
    "checksum_required",
    "parser_visible",
    "restricted_truth_visible",
    "maps_to_templates"
  ],
  "invariants": [
    "tenant_key must equal airline-demo-new",
    "source ids must use SRC-AIRDN namespace",
    "parser_visible sources must not include truth_id or evaluator-only labels",
    "restricted truth/crosswalk artifacts must not be in operational storage",
    "no real airline name may be used as tenant identity",
    "publication state is assigned by AbarVa, not client-entered"
  ],
  "storage": {
    "operational_storage": "stabairdnlabeus001",
    "restricted_evaluator_storage": "stabairdnevallab001",
    "database": "abarva_airline_demo_new_knowledge_lab"
  }
}
