{
  "_comment": [
    "Industry reference benchmark for generated procurement documents.",
    "",
    "Each document type lists the clause topics a practitioner expects to find, with a regex",
    "that must match the rendered document and a citation to the reference the requirement",
    "came from. This turns 'does it read as real?' from a matter of taste into a score.",
    "",
    "The BAA section is the strongest of these: its required provisions are regulatory, taken",
    "from 45 CFR 164.504(e)(2)(ii)(A)-(J) and (e)(2)(iii), so a missing clause is not a",
    "stylistic gap but a defective agreement. The others are drawn from published procurement",
    "and contracting checklists; they represent common practice, not law.",
    "",
    "'weight': required clauses must be present for the document to pass. expected clauses are",
    "scored and reported but do not fail the run — they are where a real instrument would go",
    "further than a demo fixture reasonably should.",
    "",
    "'phi_only': the clause is a HIPAA requirement and is scored only for contracts that handle",
    "PHI. Contracts that do not get a data protection exhibit in place of a BAA, and are still",
    "scored on every clause that is not marked this way.",
    "",
    "PATTERNS MATCH THE OBLIGATION, NOT THE VOCABULARY. An earlier draft of this file tested for",
    "bare words -- /Secretary/, /exclu/, /audit/ -- and scored a document 100% after its entire",
    "HHS-access section had been deleted, because 'Secretary' still appeared in a list of defined",
    "terms and 'excluded' still appeared in an availability formula. A benchmark that passes a",
    "document missing the very clause it is checking for is worse than no benchmark. Every pattern",
    "here is therefore anchored to language only the actual obligation would contain: a section",
    "heading, a bolded defined term, or the operative verb phrase. When adding a clause, delete",
    "the section from a generated document and confirm the benchmark fails before trusting it."
  ],
  "references": {
    "baa": "45 CFR 164.504(e)(2)(ii)(A)-(J), (e)(2)(iii); HHS sample business associate provisions",
    "msa": "MSA review checklists (CloudEagle, Icertis, ACC/Cooley form)",
    "order": "SaaS order form / subscription checklists (Zylo 23-point, UpperEdge renewal-uplift guidance)",
    "sow": "SOW structure guidance (Icertis, Sirion, Atlassian deliverable/acceptance practice)",
    "pricing": "SaaS pricing schedule practice: rate table, renewal cap, true-up/true-down separation",
    "sla": "SLA component guidance: availability definition, severity tiers, credits, exclusions, measurement",
    "amendment": "Contract amendment drafting practice: recital, amended text, survival of unamended terms",
    "invoice": "Three-way match practice: contract entitlement vs purchase order vs invoice line"
  },
  "documents": {
    "MSA": {
      "min_words": 900,
      "clauses": [
        { "id": "parties",            "weight": "required", "pattern": "(?i)by and between .+ and .+", "label": "Parties identified in one operative sentence" },
        { "id": "recitals",           "weight": "expected", "pattern": "(?i)^## Recitals", "label": "Recitals" },
        { "id": "definitions",        "weight": "required", "pattern": "(?i)^## 1\\. Definitions", "label": "Defined terms section" },
        { "id": "scope",              "weight": "required", "pattern": "(?i)shall provide the Services", "label": "Obligation to provide the Services" },
        { "id": "order_of_precedence","weight": "required", "pattern": "(?i)order of precedence is", "label": "Order of precedence among documents" },
        { "id": "change_control",     "weight": "required", "pattern": "(?i)change control procedure", "label": "Change control procedure" },
        { "id": "term",               "weight": "required", "pattern": "(?i)commences on the Effective Date and continues", "label": "Term stated" },
        { "id": "renewal",            "weight": "required", "pattern": "(?i)renews for successive", "label": "Renewal mechanics" },
        { "id": "termination_cause",  "weight": "required", "pattern": "(?i)terminate for material breach", "label": "Termination for material breach" },
        { "id": "fees_payment",       "weight": "required", "pattern": "(?i)shall pay undisputed invoices within", "label": "Payment obligation and terms" },
        { "id": "disputed_invoice",   "weight": "expected", "pattern": "(?i)Disputed amounts may be withheld", "label": "Invoice dispute mechanism" },
        { "id": "sla_ref",            "weight": "required", "pattern": "(?i)Service Level Schedule", "label": "Service Level Schedule referenced" },
        { "id": "warranty",           "weight": "required", "pattern": "(?i)warrants (it|the|that)", "label": "Warranties given" },
        { "id": "warranty_disclaimer","weight": "expected", "pattern": "(?i)implied warranties are disclaimed", "label": "Warranty disclaimer" },
        { "id": "ip",                 "weight": "required", "pattern": "(?i)right, title and interest", "label": "Intellectual property ownership" },
        { "id": "confidentiality",    "weight": "required", "pattern": "(?i)shall protect the other'?s Confidential Information", "label": "Confidentiality obligation" },
        { "id": "data_protection",    "weight": "required", "pattern": "(?i)shall execute the (Business Associate Agreement|Data Protection Exhibit)", "label": "Data protection exhibit executed" },
        { "id": "security",           "weight": "required", "pattern": "(?i)information security programme|information security program", "label": "Information security programme" },
        { "id": "breach_notice",      "weight": "required", "pattern": "(?i)Security incidents .{0,80}notified", "label": "Security incident notification" },
        { "id": "indemnity",          "weight": "required", "pattern": "(?i)shall indemnify", "label": "Indemnification" },
        { "id": "liability_cap",      "weight": "required", "pattern": "(?i)aggregate liability shall not exceed", "label": "Limitation of liability with a cap" },
        { "id": "liability_carveout", "weight": "expected", "pattern": "(?i)cap at Section .{0,20}shall not apply", "label": "Carve-outs from the liability cap" },
        { "id": "consequential",      "weight": "expected", "pattern": "(?i)liable for indirect or consequential", "label": "Exclusion of consequential damages" },
        { "id": "insurance",          "weight": "required", "pattern": "(?i)shall maintain .{0,120}liability cover of not less than", "label": "Insurance requirement with a floor" },
        { "id": "subcontractors",     "weight": "required", "pattern": "(?i)shall not subcontract", "label": "Subcontractor controls" },
        { "id": "audit",              "weight": "required", "pattern": "(?i)may audit", "label": "Audit rights" },
        { "id": "records",            "weight": "expected", "pattern": "(?i)Records shall be retained", "label": "Record retention" },
        { "id": "transition",         "weight": "required", "pattern": "(?i)shall provide transition assistance", "label": "Transition assistance on exit" },
        { "id": "assignment",         "weight": "required", "pattern": "(?i)may assign", "label": "Assignment" },
        { "id": "force_majeure",      "weight": "expected", "pattern": "(?i)\\*\\*Force majeure\\.\\*\\*", "label": "Force majeure" },
        { "id": "notices",            "weight": "required", "pattern": "(?i)Notices to .{0,80}shall be sent to", "label": "Notices" },
        { "id": "governing_law",      "weight": "required", "pattern": "(?i)governed by the laws of the State of", "label": "Governing law" },
        { "id": "severability",       "weight": "expected", "pattern": "(?i)held unenforceable", "label": "Severability" },
        { "id": "entire_agreement",   "weight": "required", "pattern": "(?i)is the entire agreement", "label": "Entire agreement" },
        { "id": "signature",          "weight": "required", "pattern": "(?i)Signature: _+", "label": "Execution block" }
      ]
    },
    "ORDER": {
      "min_words": 300,
      "clauses": [
        { "id": "incorporation", "weight": "required", "pattern": "(?i)incorporates the Master Services Agreement", "label": "Incorporates the master agreement" },
        { "id": "order_date",    "weight": "required", "pattern": "(?i)\\| Effective Date \\|", "label": "Order effective date" },
        { "id": "term",          "weight": "required", "pattern": "(?i)subscription term begins", "label": "Subscription term" },
        { "id": "entitlements",  "weight": "required", "pattern": "(?i)licensed for the Initial Term", "label": "Quantities and entitlements licensed" },
        { "id": "line_items",    "weight": "required", "pattern": "(?i)\\| Line \\| SKU \\|", "label": "Ordered line items" },
        { "id": "fees",          "weight": "required", "pattern": "(?i)\\*\\*Total Annual Value\\*\\*", "label": "Total annual value stated" },
        { "id": "billing_freq",  "weight": "required", "pattern": "(?i)Billing frequency", "label": "Billing frequency" },
        { "id": "payment_terms", "weight": "required", "pattern": "(?i)net \\d+ days", "label": "Payment terms" },
        { "id": "renewal",       "weight": "required", "pattern": "(?i)decline renewal by written notice", "label": "Renewal mechanics" },
        { "id": "notice_window", "weight": "required", "pattern": "(?i)at least \\*\\*\\d+ days\\*\\* prior to expiry", "label": "Non-renewal notice window in days" },
        { "id": "uplift_cap",    "weight": "required", "pattern": "(?i)increase in fees at renewal is capped at", "label": "Renewal uplift capped" },
        { "id": "po_status",     "weight": "expected", "pattern": "(?i)Purchase orders .{0,140}do not vary", "label": "Purchase orders do not vary the agreement" },
        { "id": "exhibits",      "weight": "required", "pattern": "(?i)^## \\d+\\. Incorporated Documents", "label": "Exhibits incorporated" },
        { "id": "precedence",    "weight": "expected", "pattern": "(?i)the Agreement controls except", "label": "Precedence against the master agreement" },
        { "id": "signature",     "weight": "required", "pattern": "(?i)Signature: _+", "label": "Execution block" }
      ]
    },
    "SOW": {
      "min_words": 400,
      "clauses": [
        { "id": "background",     "weight": "required", "pattern": "(?i)^## 1\\. Objectives", "label": "Objectives" },
        { "id": "scope_in",       "weight": "required", "pattern": "(?i)\\*\\*In scope\\.\\*\\*", "label": "Scope of work stated positively" },
        { "id": "scope_out",      "weight": "required", "pattern": "(?i)\\*\\*Out of scope\\.\\*\\*", "label": "Explicit exclusions" },
        { "id": "scope_residual", "weight": "expected", "pattern": "(?i)not expressly stated as in scope is out of scope", "label": "Residual-scope catch-all" },
        { "id": "deliverables",   "weight": "required", "pattern": "(?i)^## \\d+\\. Deliverables and Milestones", "label": "Deliverables listed" },
        { "id": "deliverable_fmt","weight": "required", "pattern": "(?i)\\| Format \\|", "label": "Deliverable formats stated" },
        { "id": "acceptance",     "weight": "required", "pattern": "(?i)\\| Acceptance Criteria \\|", "label": "Acceptance criteria per deliverable" },
        { "id": "acceptance_auth","weight": "required", "pattern": "(?i)\\*\\*Acceptance Authority\\*\\*", "label": "Named acceptance authority" },
        { "id": "acceptance_win", "weight": "required", "pattern": "(?i)accept or reject each deliverable within", "label": "Acceptance review period" },
        { "id": "rejection",      "weight": "required", "pattern": "(?i)A rejection shall state the deficiency", "label": "Rejection procedure" },
        { "id": "repeat_failure", "weight": "required", "pattern": "(?i)fails acceptance", "label": "Remedy for repeated acceptance failure" },
        { "id": "deemed_accept",  "weight": "expected", "pattern": "(?i)deemed accepted", "label": "Deemed acceptance" },
        { "id": "milestones",     "weight": "required", "pattern": "(?i)\\| Target \\|", "label": "Milestone dates" },
        { "id": "roles",          "weight": "required", "pattern": "(?i)^## \\d+\\. Roles and Responsibilities", "label": "Roles and responsibilities" },
        { "id": "assumptions",    "weight": "required", "pattern": "(?i)\\*\\*Assumption\\.\\*\\*", "label": "Assumptions" },
        { "id": "dependencies",   "weight": "required", "pattern": "(?i)\\*\\*Dependency\\.\\*\\*", "label": "Dependencies" },
        { "id": "constraints",    "weight": "expected", "pattern": "(?i)\\*\\*Constraint\\.\\*\\*", "label": "Constraints" },
        { "id": "change_control", "weight": "required", "pattern": "(?i)^## \\d+\\. Change Control", "label": "Change control" },
        { "id": "no_unpriced",    "weight": "required", "pattern": "(?i)shall not be invoiced, without an executed change order", "label": "No unpriced work outside the SOW" },
        { "id": "escalation",     "weight": "expected", "pattern": "(?i)escalate to the engagement lead", "label": "Scope dispute escalation" },
        { "id": "pricing_link",   "weight": "required", "pattern": "(?i)rates stated in the Pricing Exhibit", "label": "Pricing linkage" }
      ]
    },
    "PRICING": {
      "min_words": 300,
      "clauses": [
        { "id": "rate_table",   "weight": "required", "pattern": "(?i)\\| Line \\| SKU \\|", "label": "Rate table" },
        { "id": "unit_price",   "weight": "required", "pattern": "(?i)\\| Unit Price \\|", "label": "Unit pricing column" },
        { "id": "quantity",     "weight": "required", "pattern": "(?i)\\| Quantity \\|", "label": "Quantity column" },
        { "id": "extended",     "weight": "required", "pattern": "(?i)\\| Annual Line Total \\|", "label": "Extended line totals" },
        { "id": "total",        "weight": "required", "pattern": "(?i)\\*\\*Total Annual Value\\*\\*", "label": "Total contract value" },
        { "id": "price_hold",   "weight": "required", "pattern": "(?i)firm and fixed for the Initial Term", "label": "Price hold for the initial term" },
        { "id": "uplift_cap",   "weight": "required", "pattern": "(?i)is capped at, and shall not exceed", "label": "Renewal uplift cap" },
        { "id": "cap_noncumul", "weight": "expected", "pattern": "(?i)not cumulative or compounding", "label": "Cap is non-compounding" },
        { "id": "true_up",      "weight": "required", "pattern": "(?i)\\*\\*True-up\\.\\*\\*", "label": "True-up mechanics" },
        { "id": "true_down",    "weight": "required", "pattern": "(?i)\\*\\*True-down\\.\\*\\*", "label": "True-down / reduction rights" },
        { "id": "prof_services","weight": "required", "pattern": "(?i)Professional services under a Statement of Work are charged", "label": "Professional services rate card" },
        { "id": "rate_hold",    "weight": "expected", "pattern": "(?i)Rates are held for", "label": "Rate hold period" },
        { "id": "currency",     "weight": "required", "pattern": "(?i)All amounts are stated in", "label": "Currency" },
        { "id": "taxes",        "weight": "required", "pattern": "(?i)exclusive of sales, use and similar taxes", "label": "Taxes" },
        { "id": "invoicing",    "weight": "required", "pattern": "(?i)invoiced annually in advance", "label": "Invoicing schedule" }
      ]
    },
    "SLA": {
      "min_words": 350,
      "clauses": [
        { "id": "scope",          "weight": "required", "pattern": "(?i)This Schedule applies to", "label": "Services in scope" },
        { "id": "nonprod",        "weight": "expected", "pattern": "(?i)Non-production environments", "label": "Non-production carve-out" },
        { "id": "availability",   "weight": "required", "pattern": "(?i)maintain monthly availability of at least", "label": "Availability target" },
        { "id": "downtime_def",   "weight": "required", "pattern": "(?i)\\*\\*Downtime\\*\\* ?\"? means", "label": "Downtime defined" },
        { "id": "measurement",    "weight": "required", "pattern": "(?i)Availability is calculated as", "label": "Measurement methodology" },
        { "id": "probes",         "weight": "expected", "pattern": "(?i)independent external probes", "label": "Monitoring method named" },
        { "id": "maintenance",    "weight": "required", "pattern": "(?i)Scheduled maintenance notified at least", "label": "Scheduled maintenance window" },
        { "id": "severity",       "weight": "required", "pattern": "(?i)\\| Severity \\|", "label": "Severity tiers" },
        { "id": "response",       "weight": "required", "pattern": "(?i)Response is the time to acknowledge", "label": "Response defined" },
        { "id": "restore",        "weight": "required", "pattern": "(?i)Restore is the time to return", "label": "Restoration defined, distinct from response" },
        { "id": "credits",        "weight": "required", "pattern": "(?i)^## \\d+\\. Service Credits", "label": "Service credit schedule" },
        { "id": "credit_bands",   "weight": "required", "pattern": "(?i)\\| Monthly availability achieved \\|", "label": "Credits tied to availability bands" },
        { "id": "credit_cap",     "weight": "required", "pattern": "(?i)Aggregate credits in any contract year", "label": "Annual credit cap" },
        { "id": "credit_claim",   "weight": "required", "pattern": "(?i)To claim a credit", "label": "Credit claim procedure and deadline" },
        { "id": "credit_response","weight": "expected", "pattern": "(?i)unanswered claim is deemed accepted", "label": "Supplier response to credit claims" },
        { "id": "sole_remedy",    "weight": "required", "pattern": "(?i)sole financial remedy", "label": "Credits as sole financial remedy" },
        { "id": "exclusions",     "weight": "required", "pattern": "(?i)Service levels do not apply to failures caused by", "label": "Exclusions" },
        { "id": "burden",         "weight": "expected", "pattern": "(?i)burden of demonstrating that an exclusion applies", "label": "Burden of proof on exclusions" },
        { "id": "escalation",     "weight": "required", "pattern": "(?i)^## \\d+\\. Escalation", "label": "Escalation path" },
        { "id": "reporting",      "weight": "required", "pattern": "(?i)monthly service report within", "label": "Reporting cadence" },
        { "id": "review",         "weight": "expected", "pattern": "(?i)review service level performance quarterly", "label": "Periodic service review" },
        { "id": "chronic",        "weight": "required", "pattern": "(?i)^## \\d+\\. Chronic Failure", "label": "Chronic failure termination right" }
      ]
    },
    "BAA": {
      "min_words": 600,
      "clauses": [
        { "id": "definitions",     "weight": "required", "pattern": "(?i)Capitalised terms used but not defined", "label": "Terms defined by reference", "cite": "164.504(e)" },
        { "id": "hipaa_rules",     "weight": "required", "phi_only": true, "pattern": "(?i)\\*\\*HIPAA Rules\\*\\* ?\"? means", "label": "HIPAA Rules defined", "cite": "164.504(e)" },
        { "id": "permitted_uses",  "weight": "required", "pattern": "(?i)^## \\d+\\. Permitted Uses and Disclosures", "label": "Permitted uses and disclosures", "cite": "164.504(e)(2)(i)" },
        { "id": "mgmt_admin",      "weight": "expected", "phi_only": true, "pattern": "(?i)proper management and administration", "label": "Management and administration carve-out", "cite": "164.504(e)(4)" },
        { "id": "restrict_use",    "weight": "required", "pattern": "(?i)shall not use or further disclose", "label": "No use or disclosure beyond the agreement", "cite": "164.504(e)(2)(ii)(A)" },
        { "id": "minimum_nec",     "weight": "required", "phi_only": true, "pattern": "(?i)minimum necessary", "label": "Minimum necessary standard", "cite": "164.502(b)" },
        { "id": "safeguards",      "weight": "required", "pattern": "(?i)(use appropriate safeguards|implement appropriate technical and organisational safeguards)", "label": "Appropriate safeguards", "cite": "164.504(e)(2)(ii)(B)" },
        { "id": "subpart_c",       "weight": "required", "phi_only": true, "pattern": "(?i)Subpart C of 45 C\\.F\\.R\\. Part 164", "label": "Security Rule compliance for ePHI", "cite": "164.504(e)(2)(ii)(B)" },
        { "id": "encryption",      "weight": "expected", "pattern": "(?i)encrypted in transit and at rest", "label": "Encryption" },
        { "id": "subcontractors",  "weight": "required", "pattern": "(?i)(agrees in writing to the same restrictions|no less protective)", "label": "Subcontractors bound to same restrictions", "cite": "164.504(e)(2)(ii)(D)" },
        { "id": "sub_liability",   "weight": "expected", "pattern": "(?i)remains liable for the acts and omissions", "label": "Liability for subcontractors" },
        { "id": "report_incident", "weight": "required", "pattern": "(?i)(shall report to the Covered Entity|shall notify the customer of any personal data breach)", "label": "Report improper use, security incidents, breaches", "cite": "164.504(e)(2)(ii)(C), 164.410" },
        { "id": "breach_deadline", "weight": "required", "phi_only": true, "pattern": "(?i)no case later than sixty \\(60\\) calendar days", "label": "Breach reporting deadline", "cite": "164.410" },
        { "id": "unsuccessful",    "weight": "expected", "phi_only": true, "pattern": "(?i)Unsuccessful attempts at unauthorised access", "label": "Aggregate reporting of unsuccessful attempts" },
        { "id": "access_524",      "weight": "required", "phi_only": true, "pattern": "(?i)164\\.524", "label": "Individual access to PHI", "cite": "164.504(e)(2)(ii)(E), 164.524" },
        { "id": "amendment_526",   "weight": "required", "phi_only": true, "pattern": "(?i)164\\.526", "label": "Amendment of PHI", "cite": "164.504(e)(2)(ii)(F), 164.526" },
        { "id": "accounting_528",  "weight": "required", "phi_only": true, "pattern": "(?i)164\\.528", "label": "Accounting of disclosures", "cite": "164.504(e)(2)(ii)(G), 164.528" },
        { "id": "ce_obligations",  "weight": "required", "phi_only": true, "pattern": "(?i)carry out one or more of the Covered Entity", "label": "Compliance when performing covered entity obligations", "cite": "164.504(e)(2)(ii)(H)" },
        { "id": "ce_notify",       "weight": "expected", "phi_only": true, "pattern": "(?i)notice of privacy practices", "label": "Covered entity notifies of privacy-practice limits", "cite": "164.504(e)(1)(ii)" },
        { "id": "secretary",       "weight": "required", "phi_only": true, "pattern": "(?i)available to the Secretary", "label": "Books and records available to the Secretary", "cite": "164.504(e)(2)(ii)(I)" },
        { "id": "terminate_breach","weight": "required", "pattern": "(?i)(violated a material term|terminate for material breach of this Exhibit)", "label": "Termination for material violation", "cite": "164.504(e)(2)(iii)" },
        { "id": "return_destroy",  "weight": "required", "pattern": "(?i)shall return or destroy", "label": "Return or destruction at termination", "cite": "164.504(e)(2)(ii)(J)" },
        { "id": "infeasible",      "weight": "required", "pattern": "(?i)return or destruction is infeasible", "label": "Protections survive where return is infeasible", "cite": "164.504(e)(2)(ii)(J)" },
        { "id": "interpretation",  "weight": "expected", "phi_only": true, "pattern": "(?i)permit the parties to comply with the HIPAA Rules", "label": "Interpretation favouring compliance" },
        { "id": "signature",       "weight": "required", "pattern": "(?i)Signature: _+", "label": "Execution block" }
      ]
    },
    "AMEND-001": {
      "min_words": 300,
      "clauses": [
        { "id": "amend_number", "weight": "required", "pattern": "(?i)Amendment No\\. \\d+", "label": "Amendment number" },
        { "id": "identifies",   "weight": "required", "pattern": "(?i)amends the\\s+.{0,40}Master Services Agreement", "label": "Identifies the agreement amended" },
        { "id": "amended_date", "weight": "required", "pattern": "(?i)dated \\d{4}-\\d{2}-\\d{2}", "label": "Date of the agreement amended" },
        { "id": "effective",    "weight": "required", "pattern": "(?i)made effective as of", "label": "Amendment effective date" },
        { "id": "recital",      "weight": "required", "pattern": "(?i)WHEREAS", "label": "Recital of purpose" },
        { "id": "consideration","weight": "expected", "pattern": "(?i)in consideration of the mutual covenants", "label": "Consideration recital" },
        { "id": "old_new",      "weight": "required", "pattern": "(?i)deleted in its entirety and replaced with", "label": "Old text replaced by new" },
        { "id": "amended_text", "weight": "required", "pattern": "(?i)is amended by adding", "label": "Second amended provision" },
        { "id": "survival",     "weight": "required", "pattern": "(?i)remain in full force and effect", "label": "Unamended terms survive" },
        { "id": "conflict",     "weight": "required", "pattern": "(?i)this Amendment shall control", "label": "Conflict resolution favouring the amendment" },
        { "id": "counterparts", "weight": "expected", "pattern": "(?i)executed in counterparts", "label": "Counterparts" },
        { "id": "signature",    "weight": "required", "pattern": "(?i)Signature: _+", "label": "Execution block" }
      ]
    },
    "INVOICE-EVIDENCE": {
      "min_words": 300,
      "clauses": [
        { "id": "invoice_no",   "weight": "required", "pattern": "(?i)\\| Invoice number \\|", "label": "Invoice number" },
        { "id": "invoice_date", "weight": "required", "pattern": "(?i)\\| Invoice date \\|", "label": "Invoice date" },
        { "id": "period",       "weight": "required", "pattern": "(?i)\\| Service period \\|", "label": "Service period" },
        { "id": "po_ref",       "weight": "required", "pattern": "(?i)\\| Purchase order \\|", "label": "Purchase order reference" },
        { "id": "line_detail",  "weight": "required", "pattern": "(?i)\\| SKU \\| Quantity \\|", "label": "Line-level detail" },
        { "id": "invoice_total","weight": "required", "pattern": "(?i)\\*\\*Invoice Total\\*\\*", "label": "Invoice total" },
        { "id": "three_way",    "weight": "required", "pattern": "(?i)^## \\d+\\. Contract-to-Invoice Reconciliation", "label": "Reconciliation of contract, order and invoice" },
        { "id": "contracted",   "weight": "required", "pattern": "(?i)Contracted annual value", "label": "Contracted value stated alongside invoiced" },
        { "id": "variance",     "weight": "required", "pattern": "(?i)\\| Variance \\|", "label": "Variance stated explicitly, even when zero" },
        { "id": "variance_note","weight": "required", "pattern": "(?i)(agree to the Pricing Exhibit line for line|variance of .{0,40}exists and requires explanation)", "label": "Variance explained or affirmed as nil" },
        { "id": "entitlement",  "weight": "required", "pattern": "(?i)\\| Entitled \\| Invoiced \\|", "label": "Entitlement versus invoiced usage" },
        { "id": "approval",     "weight": "required", "pattern": "(?i)Invoice approval is delegated", "label": "Approval trail" },
        { "id": "remittance",   "weight": "required", "pattern": "(?i)due and remittable within", "label": "Remittance and due date" },
        { "id": "dispute",      "weight": "required", "pattern": "(?i)dispute as to an invoiced amount", "label": "Dispute window" }
      ]
    }
  }
}
