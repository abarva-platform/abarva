# CLOUD3 · keep build context lean and secret-free.
# IMPORTANT: src/ MUST NOT be ignored — `next build` requires it.

# Dependencies (rebuilt inside Stage 1)
node_modules
.npm
.pnp
.pnp.js

# Next build output (rebuilt inside Stage 2)
.next
out

# Coverage and reports
coverage
reports/

# Runtime Knowledge/Home active mode reads the promoted Active Tenant Access
# records. Keep the rest of reports/ out of the image, but ship this narrow
# read-only control-plane metadata so default module-context serving does not
# fall back to an empty active state in ACA.
!reports/
reports/*
!reports/active-tenant-access/
!reports/active-tenant-access/**
!reports/candidate-invisibility-guard/
!reports/candidate-invisibility-guard/**

# Local env / secrets — never ship these into an image
.env
.env.*
!.env.example

# Git metadata
.git
.gitignore
.gitattributes

# Tooling and editor
.vscode
.idea
.DS_Store
**/.DS_Store
*.log
*.swp

# Agent / harness scaffolding
.claude/
.codex-inbox/
CLAUDE.md
AGENTS.md
CYCLE_STATE.md
WAVE-2-AGENT-COORDINATION.md

# Tests / e2e (not needed for production runtime)
tests/
e2e/
playwright-report/
test-results/

# Docs (not shipped in the runtime image), except design tokens imported by app
# CSS and the enterprise-context template manifests imported at BUILD time by
# src/lib/admin/setup-data-load-center.ts (apexretail/meridian/arcturus). Those
# must be in the build context or `next build` fails type-check (added #2727).
docs/*
!docs/architecture/
docs/architecture/*
!docs/architecture/meridian-demo-findings-20260824.json
!docs/architecture/sql-drafts/
!docs/architecture/sql-drafts/**
!docs/source/
docs/source/*
!docs/source/skyharbor-v4/
!docs/source/skyharbor-v4/**
!docs/design/
docs/design/*
!docs/design/strategic-moves/
docs/design/strategic-moves/*
!docs/design/strategic-moves/tokens.css
!docs/enterprise-context/
docs/enterprise-context/*
!docs/enterprise-context/templates/
tower-mockups/
updates/

# CI metadata
.github/
