# =====================================================================
# CLOUD4 - Local Private Deployment Lab environment template
# =====================================================================
# EXAMPLE ONLY. Copy to .env.private-lab and replace ALL values
# before any non-lab use. Every value below is a placeholder and is
# committed to the repository - DO NOT put real secrets, real
# provider keys, or real customer data into this file.
#
# This file is consumed by docker-compose.private-lab.yml (CLOUD4)
# via env_file. It is not consumed by Vercel, by the Next.js build,
# or by any production runtime.
#
# Boot the lab:
#   cp .env.private-lab.example .env.private-lab
#   docker compose -f docker-compose.private-lab.yml up -d
# =====================================================================

# ---------------------------------------------------------------------
# Postgres - LAB ONLY (no real data)
# ---------------------------------------------------------------------
POSTGRES_USER=abarva_lab
POSTGRES_PASSWORD=lab_only_change_me
POSTGRES_DB=abarva_lab

# ---------------------------------------------------------------------
# MinIO (S3-compatible object store) - LAB ONLY
# ---------------------------------------------------------------------
MINIO_ROOT_USER=lab_only
MINIO_ROOT_PASSWORD=lab_only_change_me

# ---------------------------------------------------------------------
# AbarVa app - LAB ONLY references to in-network services.
# These hostnames resolve only on the abarva-private-lab bridge.
# ---------------------------------------------------------------------
DATABASE_URL=postgres://abarva_lab:lab_only_change_me@postgres:5432/abarva_lab
S3_ENDPOINT=http://minio:9000

# ---------------------------------------------------------------------
# Model gateway stub - LAB ONLY. NO real provider URL, NO provider key.
# The model-gateway-stub container serves no traffic; it exists only
# to hold the canonical hostname. Real provider keys MUST NOT be set
# here. See CLOUD1 / MG2 for the real gateway contract.
# ---------------------------------------------------------------------
MODEL_GATEWAY_URL=http://model-gateway-stub:8080
