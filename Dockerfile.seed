# syntax=docker/dockerfile:1.7
#
# First Capital context seed job image.
# Built by ACR and run inside ACA/VNet with DATABASE_URL and optional Blob
# credentials supplied by Container Apps secrets. No secrets are baked.

FROM acrabarvalab001.azurecr.io/base/node:24-bookworm-slim AS seed
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS=--conditions=react-server

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund --prefer-offline

COPY tsconfig.json ./tsconfig.json
COPY src ./src
COPY scripts ./scripts
COPY datasets ./datasets

USER node

CMD ["npx", "tsx", "scripts/jobs/load-first-capital-v2.ts"]
