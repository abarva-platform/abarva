{
  "version": "2026-06",
  "environmentKey": "client-prod-go-no-go",
  "purpose": "Non-mutating pilot client prod go/no-go packet for ENV-17.",
  "status": "scaffold_ready_before_client_prod_execution",
  "dependsOn": [
    "docs/azure/CLIENT_PRIVATE_PLANE_FACTORY_2026-06.json",
