  },
  "commandsAreTemplatesOnly": true,
  "doNotRunWithoutApproval": true,
  "doNotCreateAzureResourcesWithoutApproval": true,
  "doNotRunClientProdDataActions": true,
  "doNotChangeDnsWithoutSeparateApproval": true,
  "doNotShiftTrafficWithoutSeparateApproval": true
}
