{
  "version": "2026-06",
  "environmentKey": "client-data-onboarding-process",
  "purpose": "Non-mutating client data onboarding process packet for client preprod and client prod private planes.",
  "status": "scaffold_ready_before_client_upload",
  "dependsOn": [
    "docs/azure/CLIENT_PRIVATE_PLANE_FACTORY_2026-06.json",
    "docs/azure/PRODUCT_DEV_SYNTHETIC_DATA_BASELINE_2026-06.json",
    "docs/governance/CONTEXT_CORPUS_POLICY.md",
    "docs/governance/NEW_DATASET_ONBOARDING_POLICY.md"
  ],
  "scope": {
    "appliesTo": ["client-preprod", "client-prod"],
    "appliesToAllUploadPaths": true,
    "adminBulkPathRequired": true,
    "manifestRequired": true,
    "ingestionReceiptRequired": true,
    "sourceLineageRequired": true,
    "contextBundleProofRequired": true
  },
  "allowedInputFormats": {
    "commitEligibleWhenSchemaValid": ["csv", "json", "jsonl", "yaml"],
    "reviewRequiredUnlessDeterministicParserExists": [
      "xlsx",
      "pdf",
      "docx",
      "pptx"
    ],
    "zipSupportMayNotBeClaimedUnlessImplemented": true
  },
  "requiredTemplates": [
    "enterprise_profile",
    "leadership_org",
    "applications_systems",
    "infrastructure_cloud",
    "integrations",
    "vendor_contracts",
    "it_financials",
    "kpis_value",
    "dora_engineering_metrics",
    "incidents_itsm",
    "slas",
    "initiatives_moves",
    "risks_controls",
    "artifacts_evidence",
    "ai_data_use_cases"
  ],
  "requiredPipelineStates": [
    "source_files_received",
    "local_parse_preflight_passed",
    "admin_bulk_upload_accepted",
    "azure_blob_staged_original_files",
    "source_files_registered_in_postgres",
    "queue_or_private_worker_handoff",
    "parser_extracted_text_tables_facts_with_source_locations",
    "review_queue_received_low_confidence_or_document_derived_evidence",
    "enterprise_context_records_committed",
    "enterprise_context_facts_committed",
    "enterprise_context_chunks_committed",
    "facts_default_current_view_refreshed",
    "embeddings_search_index_refreshed",
    "tenant_scoped_retrieval_proved",
    "citation_rendering_proved",
    "promotion_status_calculated",
    "context_bundle_trace_proved",
    "module_readiness_calculated"
  ],
  "requiredReceiptFields": [
    "client_id",
    "tenant_key",
    "environment_key",
    "client_plane",
    "dataset_manifest_id",
    "upload_batch_id",
    "source_file_name",
    "source_file_hash",
    "blob_uri",
    "source_file_id",
    "parser_name",
    "parser_version",
    "template_id",
    "template_version",
    "record_count",
    "fact_count",
    "chunk_count",
    "citation_count",
    "low_confidence_count",
    "review_required_count",
    "superseded_fact_count",
    "duplicate_fact_count",
    "duplicate_chunk_count",
    "search_index_name",
    "search_index_refresh_id",
    "retrieval_probe_id",
    "context_bundle_trace_id",
    "created_at"
  ],
  "idempotencyControls": {
    "deterministicSourceFileHashRequired": true,
    "deterministicFactKeyRequired": true,
    "sameFileReuploadNoOp": true,
    "changedFactSupersedesPreviousFact": true,
    "oldFactRemainsAuditable": true,
    "oldFactExcludedFromDefaultCurrentView": true,
    "duplicateActiveFactsBlocked": true,
    "duplicateActiveChunksBlocked": true,
    "duplicateSearchDocumentsBlocked": true
  },
  "readinessControls": {
    "autoPromoteAgentReady": false,
    "initialReadinessStatus": "not_reviewed",
    "promotionCandidateRequiresRetrievalAndCitationProof": true,
    "agentReadyRequiresValidatedContextBundle": true,
    "notReviewedExcludedFromModelInput": true,
    "blockedExcludedFromModelInput": true,
    "quarantinedExcludedFromModelInput": true,
    "restrictedRequiresPolicyAllowedUse": true
  },
  "requiredHealthChecks": [
    "source_file_count",
    "blob_staging_proof",
    "source_registration_count",
    "record_count_by_type",
    "fact_count_by_lifecycle_state",
    "chunk_count_by_segment",
    "orphan_fact_count",
    "duplicate_active_fact_count",
    "duplicate_active_chunk_count",
    "search_document_count",
    "tenant_scoped_retrieval_count",
    "citation_metadata_present",
    "promotion_status_counts",
    "context_bundle_trace_proof",
    "module_readiness_summary"
  ],
  "moduleProofRequired": ["intelligence", "moves", "source", "tower"],
  "approvalGates": [
    "approve_client_upload_window",
    "approve_client_preprod_ingestion",
    "approve_client_prod_ingestion",
    "approve_parser_for_review_required_formats",
    "approve_low_confidence_evidence",
    "approve_search_index_refresh",
    "approve_agent_ready_promotion",
    "approve_client_prod_data_action"
  ],
  "forbidden": [
    "phi",
    "pii",
    "seed_shortcut_as_pilot_ready",
    "chunks_only_claimed_ready",
    "facts_only_claimed_ready",
    "indexed_only_claimed_ready",
    "agent_ready_without_context_bundle_proof",
    "ungoverned_context_to_model",
    "wrong_tenant_context_in_bundle",
    "duplicate_current_facts"
  ],
  "commandsAreTemplatesOnly": true,
  "doNotRunWithoutApproval": true,
  "doNotLoadClientDataWithoutApproval": true,
  "doNotPromoteAgentReadyWithoutApproval": true
}
