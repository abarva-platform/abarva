    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "product-dev-observability",
      "resourceGroup": "[parameters('observabilityResourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "subscriptionId": {
            "value": "[subscription().subscriptionId]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "logAnalyticsWorkspaceName": {
            "value": "[parameters('logAnalyticsWorkspaceName')]"
          },
          "applicationInsightsName": {
            "value": "[parameters('applicationInsightsName')]"
          },
          "actionGroupName": {
            "value": "[parameters('actionGroupName')]"
          },
          "actionGroupShortName": {
            "value": "[parameters('actionGroupShortName')]"
          },
          "actionGroupEmailAddress": {
            "value": "[parameters('actionGroupEmailAddress')]"
          },
          "retentionInDays": {
            "value": "[parameters('logAnalyticsRetentionInDays')]"
