            "containerAppsEnvironmentName": {
              "type": "string",
              "value": "[parameters('containerAppsEnvironmentName')]"
            },
            "smokeContainerAppName": {
              "type": "string",
              "value": "[if(parameters('deploySmokeApp'), parameters('smokeContainerAppName'), '')]"
            },
            "smokeContainerAppFqdn": {
              "type": "string",
              "value": "[if(parameters('deploySmokeApp'), reference(resourceId('Microsoft.App/containerApps', parameters('smokeContainerAppName')), '2024-03-01').configuration.ingress.fqdn, '')]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('controlPlaneResourceGroupName'))]",
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('observabilityResourceGroupName')), 'Microsoft.Resources/deployments', 'product-dev-observability')]"
      ]
