    },
    "applicationInsightsName": {
      "type": "string",
      "value": "[parameters('applicationInsightsName')]"
    },
    "runtimeManagedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('controlPlaneResourceGroupName')), 'Microsoft.Resources/deployments', 'product-dev-containerapps-smoke'), '2025-04-01').outputs.runtimeManagedIdentityPrincipalId.value]"
    },
    "containerAppsEnvironmentName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('controlPlaneResourceGroupName')), 'Microsoft.Resources/deployments', 'product-dev-containerapps-smoke'), '2025-04-01').outputs.containerAppsEnvironmentName.value]"
    },
    "smokeContainerAppName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('controlPlaneResourceGroupName')), 'Microsoft.Resources/deployments', 'product-dev-containerapps-smoke'), '2025-04-01').outputs.smokeContainerAppName.value]"
    },
    "smokeContainerAppFqdn": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('controlPlaneResourceGroupName')), 'Microsoft.Resources/deployments', 'product-dev-containerapps-smoke'), '2025-04-01').outputs.smokeContainerAppFqdn.value]"
    }
  }
}