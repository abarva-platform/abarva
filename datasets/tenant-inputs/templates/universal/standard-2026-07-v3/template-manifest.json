  "azureLanding": {
    "container": "tenant-inputs",
    "prefixPattern": "tenant-inputs/{tenant_key}/{intake_id}/raw/",
    "validatedPrefixPattern": "tenant-inputs/{tenant_key}/{intake_id}/validated/",
    "archivePrefixPattern": "tenant-inputs/archive/{tenant_key}/{intake_id}/",
    "fileNamePattern": "{tenant_key}__{template_name}__{as_of_yyyymmdd}__{source_owner}__r{revision}.csv"
  },
  "guardrails": {
    "oneUniversalTemplateSet": true,
    "industrySpecificForksAllowed": false,
    "qualityGateRequiredBeforeLoad": true,
    "activeLoadRequiresCanonicalRoot": true
