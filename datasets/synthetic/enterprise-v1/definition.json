  "leadership_themes": [
    {
      "theme": "Star ambition and execution",
      "observation": "The 4.5 Star ambition is ahead of the 4.1 synthetic current measure; programme progress needs a clearer bridge to the outcome.",
      "evidence_object_id": "MET-0001"
    },
    {
      "theme": "Value validation",
      "observation": "Only 24 percent of synthetic claimed benefits is represented as finance-validated; the value register needs a reconciliation basis.",
      "evidence_object_id": "MET-0034"
    },
    {
      "theme": "Integration concentration",
      "observation": "A small number of data targets carry concentrated inbound flows; recovery posture should be checked before further expansion.",
      "evidence_object_id": "DATA-0001"
    },
    {
      "theme": "Accountability coverage",
      "observation": "Application ownership is incomplete in the long tail, which limits confident service and risk attribution.",
      "evidence_object_id": "APP-0061"
    },
    {
      "theme": "Commercial timing",
      "observation": "One renewal notice window is at risk and should be resolved against the contract register rather than inferred from spend rank.",
      "evidence_object_id": "CTR-0002"
    },
    {
      "theme": "Priority alignment",
      "observation": "One programme lacks a declared priority and accountable owner; the connection should remain unresolved until assigned.",
      "evidence_object_id": "PROG-0024"
    }
  ],
