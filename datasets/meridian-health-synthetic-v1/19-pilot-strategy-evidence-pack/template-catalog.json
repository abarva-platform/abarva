{
  "tenant": "meridian-health",
  "display_name": "Meridian Health / PHA strategy pilot",
  "version": "2026-06-14",
  "privacy_standard": "synthetic_or_deidentified_aggregate_only",
  "starter_corpus_file": "corpus_pattern_starters.jsonl",
  "templates": [
    {
      "id": "use-case-intake",
      "file": "use_case_intake.csv",
      "move_phases": ["P0", "P1"],
      "owner_role": "Strategy Lead",
      "required_fields": ["use_case_name", "business_area", "sponsor_title", "problem_statement", "value_hypothesis", "target_decision"],
      "evidence_checks": ["sponsor title present", "value hypothesis present", "no PHI or PII"]
    },
    {
      "id": "kpi-baseline",
      "file": "kpi_baseline.csv",
      "move_phases": ["P1", "P2", "P4"],
      "owner_role": "Analytics / Finance Lead",
      "required_fields": ["use_case_name", "kpi_name", "baseline_value", "target_value", "period", "source", "confidence"],
      "evidence_checks": ["period present", "source present", "baseline is aggregated"]
    },
    {
      "id": "current-state-process",
      "file": "current_state_process.csv",
      "move_phases": ["P2", "P3"],
      "owner_role": "Process Owner",
      "required_fields": ["process_name", "step", "owner_role", "system", "pain_point", "evidence_source"],
      "evidence_checks": ["step sequence present", "owner role not person name", "source present"]
    },
    {
      "id": "system-data-landscape",
      "file": "system_data_landscape.csv",
      "move_phases": ["P2", "P3", "P4"],
      "owner_role": "Enterprise Architecture / Data Lead",
      "required_fields": ["system_name", "category", "owner_role", "data_domain", "integration_role", "known_gap", "criticality"],
      "evidence_checks": ["system owner role present", "data sensitivity classified", "no credentials"]
    },
    {
      "id": "vendor-contract-context",
      "file": "vendor_contract_context.csv",
      "move_phases": ["P2", "P3", "P4"],
      "owner_role": "Procurement / Legal",
      "required_fields": ["vendor", "capability", "contract_status", "renewal_window", "baa_status", "ai_clause_status", "risk"],
      "evidence_checks": ["BAA status present", "AI clause status present", "renewal window present"]
    },
    {
      "id": "operating-model-roles",
      "file": "operating_model_roles.csv",
      "move_phases": ["P1", "P2", "P3", "P5"],
      "owner_role": "Operating Model Lead",
      "required_fields": ["function", "role_title", "decision_right", "pain_point", "capacity_constraint", "required_in_pilot"],
      "evidence_checks": ["role titles only", "decision right present", "capacity constraint present"]
    },
    {
      "id": "evidence-register",
      "file": "evidence_register.csv",
      "move_phases": ["P0", "P1", "P2", "P3", "P4", "P5"],
      "owner_role": "Steward / Program Manager",
      "required_fields": ["artifact_name", "artifact_type", "owner_role", "use_case", "source_basis", "classification", "confidence"],
      "evidence_checks": ["classification present", "confidence present", "citation-ready source basis"]
    },
    {
      "id": "decision-log",
      "file": "decision_log.csv",
      "move_phases": ["P1", "P2", "P3", "P4", "P5"],
      "owner_role": "Move Sponsor",
      "required_fields": ["decision", "status", "owner_role", "date_needed", "dependency", "risk_if_delayed"],
      "evidence_checks": ["owner role present", "status present", "dependency present"]
    },
    {
      "id": "data-readiness-summary",
      "file": "data_readiness_summary.csv",
      "move_phases": ["P2", "P3", "P4", "P5"],
      "owner_role": "Data Product Owner",
      "required_fields": ["use_case", "data_domain", "available_summary_level", "quality", "refresh_cadence", "gap", "needed_for_phase"],
      "evidence_checks": ["summary level present", "gap mapped to Move phase", "minimum necessary data"]
    },
    {
      "id": "risk-guardrail-register",
      "file": "risk_guardrail_register.csv",
      "move_phases": ["P1", "P2", "P3", "P4", "P5"],
      "owner_role": "Risk / Privacy / Compliance",
      "required_fields": ["use_case", "risk_type", "guardrail", "human_review_required", "blocked_action", "approval_owner"],
      "evidence_checks": ["blocked action present", "approval owner role present", "PHI/PII default blocked"]
    }
  ]
}
