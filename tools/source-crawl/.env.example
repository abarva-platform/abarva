# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.

# ---- Tenant under audit ----
# Default below points the crawler at AbarVa's own /source surface.
# Local dev:  http://localhost:3000/source
# Prod:       https://app.abarva.ai/source
TENANT_URL=https://app.abarva.ai/source

# Hostname allow-list — crawler refuses to follow links off this host.
TENANT_HOSTNAME=app.abarva.ai

# Path prefix the crawler stays inside. /source covers the portfolio,
# /source/new (origination), and /source/events/{id} (canvas).
TENANT_PATH_PREFIX=/source

# Sign-in URL — used by `npm run save-session` to land you in Clerk's
# OTP flow. The script then waits for you to complete it manually.
SIGNIN_URL=https://app.abarva.ai/sign-in

# ---- Auditor identity (no password here — handled by save-session) ----
AUDITOR_EMAIL=auditor@your-org.com
AUDITOR_ROLE=read_only_auditor

# ---- Crawl behavior ----
CRAWL_MAX_PAGES=5000
CRAWL_MAX_HOURS=2
CRAWL_DELAY_MIN_MS=800
CRAWL_DELAY_MAX_MS=1200
CRAWL_HEADED=true

# Dry-pass cap — crawler stops here when run with `npm run crawl:dry`.
CRAWL_DRY_PAGES=50

# ---- PII handling ----
# Strictest mode: redact in JSON AND in raw HTML
PII_REDACTION_MODE=strictest

# ---- Optional: sandbox for write-test slices later ----
# Leave blank unless/until a sandbox tenant is provisioned
SANDBOX_URL=
