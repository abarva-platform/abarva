{
  "name": "source-crawl",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Playwright crawler for the /source surface — slice 1 of the sourcing-platform audit pipeline.",
  "scripts": {
    "save-session": "tsx src/auth.ts",
    "crawl:dry": "tsx src/crawl.ts --dry",
    "crawl:full": "tsx src/crawl.ts --full",
    "scenario": "tsx src/scenario.ts",
    "scenario:create-event": "tsx src/scenario.ts create-event",
    "scenario:walk-canvas": "tsx src/scenario.ts walk-canvas",
    "scenario:promote-stage": "tsx src/scenario.ts promote-stage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
